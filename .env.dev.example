# Copy to .env.dev before the first dev-container start. This file is ignored.
# These initial passwords are read only while users.json is first created.
NASDASH_ADMIN_PASSWORD=replace-with-a-local-test-password
NASDASH_VIEWER_PASSWORD=replace-with-a-local-viewer-password

# Generate with: openssl rand -hex 32
# Keep stable while reusing the nasdash_dev_data volume.
NASDASH_JWT_SECRET=replace-with-a-stable-local-test-secret

# Optional. The launcher checks this port and chooses the next free local port
# when the default 2514 is occupied. An explicitly configured occupied port fails.
# NASDASH_DEV_PORT=2514
